<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!-- This is generated file. It is composed from template fragment which can be extended -->

    {{> e2e/pom.xml.project-definition.fragment.hbs }}

    <packaging>pom</packaging>

    <properties>
        <judo-meta-ui-version>{{ judoMetaUiVersion }}</judo-meta-ui-version>
        <frontend-maven-plugin-version>1.12.1</frontend-maven-plugin-version>

        <judo-ui-react-template-version>{{ judoUiReactTemplateVersion }}</judo-ui-react-template-version>
        <judo-ui-typescript-rest-template-version>{{ judoUiTypescriptRestTemplateVersion }}</judo-ui-typescript-rest-template-version>
        <judo-ui-e2e-template-version>{{ judoUiE2eTemplateVersion }}</judo-ui-e2e-template-version>


        <node-version>{{# if nodeVersion }}{{ nodeVersion }}{{ else }}18.16.0{{/ if}}</node-version>
        <pnpm-version>{{# if pnpmVersion }}{{ pnpmVersion }}{{ else }}8.6.1{{/ if}}</pnpm-version>

        <node-install-dir>${maven.multiModuleProjectDirectory}/.nodejs</node-install-dir>

        {{> e2e/pom.xml.properties-definition.fragment.hbs }}
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                {{> e2e/pom.xml.extra-plugin-management.fragment.hbs }}
            </plugins>
        </pluginManagement>
    </build>

    <dependencies>
        <dependency>
            <groupId>hu.blackbelt.judo.meta</groupId>
            <artifactId>judo-ui-generator-maven-plugin</artifactId>
            <version>${judo-meta-ui-version}</version>
        </dependency>
        <dependency>
            <groupId>hu.blackbelt.judo.generator</groupId>
            <artifactId>judo-ui-playwright-e2e-template</artifactId>
            <version>${judo-ui-e2e-template-version}</version>
        </dependency>

        {{> e2e/pom.xml.extra-dependencies.fragment.hbs }}
    </dependencies>

    <profiles>
        <profile>
            <id>build-frontend-react-model</id>
            <activation>
                <property>
                    <name>!skipFrontendModel</name>
                </property>
            </activation>

            <modules>
                <module>model</module>
            </modules>
        </profile>

        <profile>
            <id>prepare-nodejs</id>
            <activation>
                <property>
                    <name>!skipPrepareNodeJS</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.eirslett</groupId>
                        <artifactId>frontend-maven-plugin</artifactId>
                        <version>${frontend-maven-plugin-version}</version>
                        <executions>
                            <execution>
                                <id>install node and pnpm</id>
                                <goals>
                                    <goal>install-node-and-pnpm</goal>
                                </goals>
                                <phase>generate-resources</phase>
                            </execution>
                        </executions>
                        <configuration>
                            <nodeVersion>v${node-version}</nodeVersion>
                            <pnpmVersion>${pnpm-version}</pnpmVersion>
                            <installDirectory>${node-install-dir}</installDirectory>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>build-e2e</id>
            <activation>
                <property>
                    <name>!skipE2E</name>
                </property>
            </activation>

            <modules>
                {{# each actorTypes as |actorType| }}
                    <module>{{ pathName actorType.fQName }}</module>
                {{/ each }}
            </modules>
        </profile>
    </profiles>

</project>
